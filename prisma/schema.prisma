generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  username        String        @unique
  passwordHash    String
  email           String?
  emailVerifiedAt DateTime?
  displayName     String?
  avatar          Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?
  organizationId  String?
  organization    Organization? @relation("OrgMember", fields: [organizationId], references: [id])
  orgAdminOf      Organization? @relation("OrgAdmin")
  createdAt       DateTime      @default(now())
  sales           Transaction[]
  expenses        Expense[]
  authTokens      AuthToken[]

  @@unique([organizationId, email])
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?  @unique
  adminId   String   @unique
  admin     User     @relation("OrgAdmin", fields: [adminId], references: [id])
  members   User[]   @relation("OrgMember")
  createdAt DateTime @default(now())
}

model Transaction {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  soldAt        DateTime          @default(now())
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id])
  note             String            @default("")
  taxRateBps       Int               @default(0)
  subtotalCents    Int
  taxCents         Int
  totalCents       Int
  receiverName     String?
  receiverAccount  String?
  receiverContact  String?
  receiverAddress  String?
  lines            TransactionLine[]
}

model Expense {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  spentAt     DateTime @default(now())
  amountCents Int
  note        String   @default("")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, kind])
}

model TransactionLine {
  id             String      @id @default(cuid())
  transactionId  String
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  name           String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  sortOrder      Int
}
