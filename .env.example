# SQLite file, relative to prisma/schema.prisma (becomes prisma/dev.db).
# Docker overrides this to file:/data/pos.db
DATABASE_URL="file:./dev.db"

# Seeded agent login (no public signup)
AUTH_USERNAME=agent
AUTH_PASSWORD=changeme

# iron-session cookie secret — must be at least 32 characters
SESSION_SECRET=change-this-to-a-long-random-string-32ch

# Currency label for display only (amounts are stored as integer cents)
APP_CURRENCY=NGN

# Gemini key for receipt scan (https://aistudio.google.com/apikey). Leave empty to type sales by hand.
GEMINI_API_KEY=
# Optional. Default: gemini-3.7-flash
# GEMINI_MODEL=gemini-3.7-flash

# Optional: transactional email (password reset codes, signup verification, org alerts).
# When neither email transport is configured, new accounts are auto-verified and no emails are sent.

# Brevo HTTPS API (https://brevo.com) — preferred on hosts that block SMTP ports
# (e.g. Render free tier blocks 25/465/587). Takes precedence over SMTP.
# Requires the sender email below to be verified in Brevo.
BREVO_API_KEY=
# Sender for emails, "Name <email>". The email must be verified in Brevo.
MAIL_FROM="Tallyra <you@example.com>"

# SMTP fallback for hosts that allow outbound SMTP (e.g. local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER
# SMTP_FROM="Tallyra <you@example.com>"
